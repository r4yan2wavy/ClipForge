{
  "paths": {
    "root": ".",
    "state": "data/state.sqlite3",
    "inbox": "inbox",
    "prepared": "prepared",
    "cache": "data/cache",
    "logs": "data/logs"
  },
  "speech": {
    "model": "models/faster-whisper-small",
    "device": "cpu",
    "compute_type": "int8",
    "language": "en",
    "cpu_threads": 4,
    "beam_size": 3
  },
  "brain": {
    "ollama_url": "http://127.0.0.1:11434",
    "model": "qwen3:4b-instruct",
    "context_tokens": 8192,
    "window_chars": 7000,
    "overlap_spans": 5,
    "min_clip_s": 20.0,
    "max_clip_s": 60.0,
    "max_clips": 3,
    "correction_retries": 1,
    "timeout_s": 600
  },
  "render": {
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 21,
    "preset": "veryfast",
    "caption_format": "ass",
    "font": "Arial",
    "font_size": 64,
    "margin_v": 230,
    "loudness_lufs": -16.0,
    "music_gain_db": -24.0,
    "ducking": true
  },
  "discovery": {
    "api_key_env": "YOUTUBE_API_KEY",
    "channel_ids": [],
    "search_terms": [],
    "search_every_hours": 24,
    "monitor_every_minutes": 60,
    "max_pages": 2,
    "page_size": 50,
    "daily_budget_units": 500,
    "search_daily_budget": 20,
    "search_call_cost": 1,
    "general_read_call_cost": 1,
    "min_duration_s": 300,
    "max_duration_s": 14400,
    "max_age_days": 30,
    "language": "en",
    "cache_minutes": 30,
    "retention_days": 28,
    "derived_metrics_enabled": false,
    "approval_reference": null,
    "velocity_floor": 1.0,
    "min_subscribers": 1000,
    "confirmation_count": 3,
    "threshold_velocity": 100.0,
    "threshold_lift": 1.5,
    "min_observation_minutes": 15.0,
    "baseline_min_samples": 5,
    "baseline_age_tolerance_hours": 2.0,
    "baseline_ratio_threshold": 1.5,
    "max_confirmation_gap_hours": 3.0
  },
  "upload": {
    "enabled": false,
    "target_channel_id": "",
    "client_secrets": "secrets/client_secret.json",
    "token_file": "secrets/token.json",
    "privacy_status": "private",
    "made_for_kids": null,
    "contains_synthetic_media": null,
    "min_lead_minutes": 60,
    "chunk_bytes": 8388608,
    "max_retries": 3,
    "request_timeout_s": 60,
    "poll_every_minutes": 15
  },
  "timezone": "America/New_York",
  "max_job_attempts": 3
}